{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items"
  ],
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "section",
          "text",
          "confidence",
          "evidence"
        ],
        "properties": {
          "kind": {
            "enum": [
              "fact",
              "event",
              "preference",
              "task",
              "decision",
              "self",
              "question"
            ]
          },
          "section": {
            "enum": [
              "identity",
              "preferences",
              "projects",
              "people",
              "environment",
              "procedures",
              "lessons",
              "open_loops"
            ]
          },
          "text": {
            "type": "string",
            "maxLength": 240
          },
          "subject": {
            "type": "string",
            "maxLength": 60
          },
          "entities": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "string",
              "maxLength": 40
            }
          },
          "date_ref": {
            "enum": [
              "d0",
              "d1",
              "d2",
              "d3",
              "d4",
              "none"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "episode_id",
                "quote"
              ],
              "properties": {
                "episode_id": {
                  "type": "string",
                  "maxLength": 40
                },
                "quote": {
                  "type": "string",
                  "maxLength": 200
                }
              }
            }
          }
        }
      }
    }
  }
}
